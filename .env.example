# cp .env.example .env 후 값만 바꾼다. compose가 자동 인식, npm run dev/start는 server.ts가 자동 로드.
# shell에 직접 export한 값이 .env보다 우선한다.
PORT=8091
PUBLIC_BASE_URL=http://localhost:8091
CLIENT_ID=test
CLIENT_SECRET=test
GOV_CLIENT_ID=test-gov
GOV_CLIENT_SECRET=test-gov-secret
# CLIENT_* 변경은 첫 기동 1회만 시드되어 SQLite에 영속된다.
# 변경 후: docker compose down && rm -rf ./data && docker compose up -d --build
